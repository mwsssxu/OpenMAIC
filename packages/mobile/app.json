{
  "expo": {
    "name": "OpenMAIC",
    "slug": "openmaic-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ceban",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ceban.mobile"
    },
    "android": {
      "package": "com.ceban.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
