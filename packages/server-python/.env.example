# =============================================================================
# OpenMAIC Python Backend Environment Variables
# Copy to .env and fill in the values.
# =============================================================================

# --- 应用配置 ---
SECRET_KEY=your-secret-key-change-in-production
DEBUG=true

# --- 数据库 ---
DATABASE_URL=postgres://maic:password@localhost:5432/maic
REDIS_URL=redis://localhost:6379

# --- LLM 提供商 ---
# API配置 (DashScope/OpenAI/DeepSeek等)
OPENAI_API_KEY=sk-your-api-key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型路由配置
DEFAULT_MODEL=qwen3.6-plus        # 默认文本模型
VISION_MODEL_ID=qwen-vl-max       # 视觉/多模态模型
TTS_MODEL_ID=qwen3-tts-flash      # TTS语音合成模型
IMAGE_GEN_MODEL_ID=wanx-v1        # 图像生成模型

# TTS专用API (可选，默认使用OPENAI_API_*)
TTS_API_KEY=
TTS_API_BASE=

# 其他LLM提供商 (可选)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# 网络代理 (可选)
HTTP_PROXY=

# --- 阿里云 OSS ---
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# --- OAuth ---
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3030","http://localhost:3000"]